<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- ClaudeWhip sensor daemon: the only root part. Reads the accelerometer and
     broadcasts hits on a unix socket owned by the user below. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.claudewhip.sensord</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{SENSOR_BIN}}</string>
    <string>--owner</string>
    <string>{{OWNER_UID}}</string>
    <string>--socket</string>
    <string>{{SOCKET}}</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Adaptive</string>
  <key>StandardErrorPath</key>
  <string>/var/log/claudewhip-sensord.log</string>
</dict>
</plist>
