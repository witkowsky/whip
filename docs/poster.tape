# vhs docs/poster.tape  ->  docs/media/poster.png (1.91:1, LinkedIn-friendly)
Output docs/media/poster.gif
Set Shell "bash"
Set FontFamily "Menlo"
Set FontSize 42
Set Width 2400
Set Height 1256
Set Padding 80
Set Theme "Catppuccin Mocha"
Set TypingSpeed 0
Hide
Type "clear; node scripts/poster.js"
Enter
Sleep 1.5s
Show
Sleep 0.5s
Screenshot docs/media/poster.png
